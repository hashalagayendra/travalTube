datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Authentication Table
model Admin {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  email     String   @unique
  password  String // Hashed password
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

// Homepage Hero Banner
model HomepageHero {
  id         Int      @id @default(1)
  heroFirst  String   @default("Discover the")
  heroSecond String   @default("Real")
  heroScript String   @default("Sri Lanka")
  heroDesc   String   @db.Text
  bgImage    String?  @db.LongText // Stores direct image (Base64) or URL
  updatedAt  DateTime @updatedAt

  @@map("homepage_hero")
}

// Tour Categories & Options Section (TourOptionsSection.tsx)
model TourCategory {
  id          Int      @id @default(autoincrement())
  title       String
  badge       String   @default("Tour Option")
  description String   @db.Text
  actionText  String   @default("Explore Tours")
  image       String   @db.LongText // Direct Base64 image data or URL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tour_categories")
}
