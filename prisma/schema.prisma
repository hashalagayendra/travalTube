datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Authentication Table
model Admin {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  email     String   @unique
  password  String // Hashed password
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

// Homepage Hero Banner
model HomepageHero {
  id         Int      @id @default(1)
  heroFirst  String   @default("Discover the")
  heroSecond String   @default("Real")
  heroScript String   @default("Sri Lanka")
  heroDesc   String   @db.Text
  bgImage    String?  @db.LongText // Stores direct image (Base64) or URL
  updatedAt  DateTime @updatedAt

  @@map("homepage_hero")
}

// Tour Categories & Options Section (TourOptionsSection.tsx)
model TourCategory {
  id          Int      @id @default(autoincrement())
  title       String
  badge       String   @default("Tour Option")
  description String   @db.Text
  actionText  String   @default("Explore Tours")
  image       String   @db.LongText // Direct Base64 image data or URL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tour_categories")
}

// About Us - Welcome & Company Introduction Section (AboutView.tsx & WelcomeSection.tsx)
model AboutSection {
  id               Int      @id @default(1)
  eyebrow          String   @default("WELCOME TO")
  titleMain        String   @default("Travel Tube Lanka")
  titleAccent      String   @default("(Pvt) Ltd")
  paragraph1       String   @db.Text
  paragraph2       String   @db.Text
  topImage         String   @db.LongText // Top wide collage photo
  bottomLeftImage  String   @db.LongText // Bottom left collage photo
  bottomRightImage String   @db.LongText // Bottom right collage photo
  updatedAt        DateTime @updatedAt

  @@map("about_section")
}

// About Us - Why Choose Us Highlights (4 Pillars)
model WhyChoosePillar {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("why_choose_pillars")
}

// Core Services - 9 Agency Service Cards (app/services/page.tsx & ServicesView.tsx)
model ServiceCard {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  icon        String   @default("Plane") // Lucide React icon name (e.g. Plane, Map, Calendar, FileText, Globe, Mountain, ArrowLeftRight, CreditCard, Car)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("service_cards")
}

// Tour Packages Section (PackagesSection.tsx & PackagesView.tsx)
model TourPackage {
  id          Int      @id @default(autoincrement())
  name        String
  days        String   @default("1 Day")
  locations   String
  description String   @db.Text
  rating      Float    @default(4.9)
  reviews     Int      @default(100)
  image       String   @db.LongText // Direct Base64 or image URL/path
  alt         String   @default("Tour package image")
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tour_packages")
}

// Destinations Section (DestinationsSection.tsx, DestinationsView.tsx & app/destination/page.tsx)
model Destination {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  badge       String   @default("Heritage")
  location    String
  description String   @db.Text
  image       String   @db.LongText // Direct Base64 or image URL/path
  isHomepage  Boolean  @default(false)
  isPinned    Boolean  @default(false) // Pin to Top 2 featured cards on /destination
  category    String   @default("heritage") // "all" | "beach" | "heritage" | "wildlife" | "highlands"
  highlights  String?  @db.Text
  duration    String?  @default("Full Day")
  bestSeason  String?  @default("Year Round")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("destinations")
}

// Photo Gallery Showcase (app/gallery/page.tsx & GalleryView.tsx)
model GalleryItem {
  id            Int      @id @default(autoincrement())
  title         String
  location      String
  category      String   @default("culture") // "nature" | "wildlife" | "culture" | "beaches" | "adventure"
  categoryLabel String   @default("Culture")
  image         String   @db.LongText // Direct Base64 or image URL/path
  description   String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("gallery_items")
}

// Contact Us Page Content & Core Contact Cards (ContactView.tsx & app/contact/page.tsx)
model ContactInfo {
  id              Int      @id @default(1)
  // Section 1: Header Greeting
  eyebrow         String   @default("WE ARE HERE FOR YOU")
  headingWord     String   @default("Get In")
  headingAccent   String   @default("Touch")
  subheading      String   @db.Text

  // Section 2: Core 3 Info Cards
  // Card 1: Office Location
  officeTitle     String   @default("Our Office Location")
  companyName     String   @default("Travel Tube Lanka(Pvt) Ltd")
  addressLine1    String   @default("452/01/A/01, Kandy Road")
  addressCity     String   @default("Kadawatha, Sri Lanka")

  // Card 2: Phone Numbers
  phoneTitle      String   @default("Contact Number")
  phone1          String   @default("+94 76 2399399")
  phone2          String   @default("+94 11 4399699")

  // Card 3: Email Addresses
  emailTitle      String   @default("Email Address")
  primaryEmail    String   @default("info@traveltube.lk")
  secondaryEmail  String   @default("support@traveltube.lk")

  updatedAt       DateTime @updatedAt

  @@map("contact_info")
}

// User Contact Messages & Inquiries (app/contact/page.tsx & InquiriesView.tsx)
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  message   String   @db.Text
  subject   String?  @default("General Contact Message")
  status    String   @default("New Lead") // "New Lead" | "In Review" | "Quote Sent" | "Confirmed" | "Archived"
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

// Global Website & Agency Settings (SettingsView.tsx)
model SiteSettings {
  id                    Int      @id @default(1)
  // General & WhatsApp
  companyBrand          String   @default("TravelTube Lanka")
  sltdaReg              String   @default("SLTDA/SQA/TA/2026/0491")
  hotline               String   @default("+94 77 123 4567")
  whatsapp              String   @default("+94 77 987 6543")
  email                 String   @default("info@traveltubelanka.com")
  officeHours           String   @default("Mon – Sat: 8:00 AM – 7:00 PM (Sri Lanka Time GMT+5:30)")
  address               String   @db.Text

  // Currency & Policies
  currency              String   @default("USD")
  depositPercent        Int      @default(20)
  cancellationPolicy    String   @db.Text

  // Social & Reviews
  tripAdvisorUrl        String   @default("https://www.tripadvisor.com/Attraction_Review-TravelTube_Lanka")
  googleReviewsUrl      String   @default("https://g.page/r/traveltube-lanka-reviews")
  instagramUrl          String   @default("https://instagram.com/traveltubelanka")
  facebookUrl           String   @default("https://facebook.com/traveltubelankatours")
  youtubeUrl            String?  @default("https://youtube.com/@traveltubelanka")
  tiktokUrl             String?  @default("https://tiktok.com/@traveltubelanka")

  // SEO & Announcement
  announcementEnabled   Boolean  @default(true)
  announcementText      String   @default("🔥 Early Bird Offer: Save 10% on Private Chauffeur Winter 2026/27 Tours. Enquire Today!")
  metaTitle             String   @default("TravelTube Lanka | Discover the Real Sri Lanka - Tailor Made Tours & Safaris")
  metaDescription       String   @db.Text

  updatedAt             DateTime @updatedAt

  @@map("site_settings")
}

// Global Footer Settings & Quick Links (Footer.tsx & SettingsView.tsx)
model FooterSettings {
  id                  Int      @id @default(1)
  brandDescription    String   @db.Text
  address             String   @db.Text
  phones              String   @default("+94 76 2399399 / +94 11 4399699")
  phonePrimary        String   @default("+94762399399")
  phoneSecondary      String   @default("+94114399699")
  email               String   @default("info@traveltube.lk")
  websiteLabel        String   @default("www.traveltube.lk")
  websiteUrl          String   @default("https://traveltube.lk/about-us.php#")
  
  // What You Want cards
  want1Title          String   @default("One day tour")
  want1Url            String   @default("https://traveltube.lk/tour-packages.php?id=1")
  want2Title          String   @default("Round Tour")
  want2Url            String   @default("https://traveltube.lk/tour-packages.php?id=2")
  want3Title          String   @default("Plan your Tour")
  want3Url            String   @default("https://traveltube.lk/plan-tour.php")

  // Bottom Bar & Copyright
  copyrightText       String   @default("Travel Tube Lanka (Pvt) Ltd. All Rights Reserved.")
  photoCreditText     String   @default("Photo: dronepicr · CC BY 2.0 · cropped for display")
  photoCreditUrl      String   @default("https://commons.wikimedia.org/wiki/File:Sigiriya_lion_rock_Luftbild_(29781058870).jpg")

  updatedAt           DateTime @updatedAt

  @@map("footer_settings")
}
